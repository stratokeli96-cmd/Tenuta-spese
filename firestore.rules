rules_version = '2';

// Ogni utente autenticato può leggere/scrivere SOLO il proprio sottoalbero
// users/{uid}/... . Nessun accesso a dati di altri utenti, nessun accesso anonimo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
